{
  "name": "cation-media",
  "version": "0.3.42",
  "description": "CationMedia — media viewer and editor",
  "author": "StudioCation",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "postinstall": "node scripts/prepare.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tabler/icons": "3.46.0",
    "ag-psd": "^31.0.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.3.0",
    "three": "^0.186.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.studiocation.viewer3d",
    "productName": "CationMedia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json",
      "shared/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "scripts/blend_export.py",
        "to": "blend_export.py"
      },
      {
        "from": "scripts/fbx_export.py",
        "to": "fbx_export.py"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "audio/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "audio/LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "audio/README.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "tif",
          "tiff",
          "png",
          "gif",
          "webp",
          "bmp"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Editor"
      },
      {
        "ext": [
          "glb",
          "gltf",
          "fbx",
          "obj",
          "stl",
          "ply",
          "dae",
          "3ds"
        ],
        "name": "3D Model",
        "description": "3D model",
        "role": "Viewer"
      },
      {
        "ext": [
          "wav",
          "mp3",
          "flac",
          "ogg",
          "oga",
          "opus",
          "m4a",
          "aac",
          "aif",
          "aiff",
          "wma",
          "ac3",
          "aiffc",
          "aifc",
          "caf",
          "amr",
          "ape",
          "mka",
          "weba"
        ],
        "name": "Audio",
        "description": "Audio file",
        "role": "Editor"
      },
      {
        "ext": [
          "mp4",
          "m4v",
          "mov",
          "mkv",
          "webm",
          "avi",
          "wmv",
          "flv",
          "mpg",
          "mpeg",
          "ts",
          "mts",
          "m2ts",
          "ogv",
          "3gp",
          "vob",
          "mxf"
        ],
        "name": "Video",
        "description": "Video file",
        "role": "Editor"
      }
    ]
  }
}
